# Canonical .gitignore — Next.js + Python (bun/uv) projects.
# Scaffolded to .gitignore by init-project.sh. Keep the env rules exact:
# real env files are ignored; .env.example stays tracked.

# --- Secrets: never commit real env files ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# Belt-and-suspenders: the example is ALWAYS tracked, even if a broad
# .env* pattern is ever added above.
!.env.example

# --- Node / bun ---
node_modules/
.pnp
.pnp.*
# bun.lock IS committed — do not ignore it.

# --- Next.js ---
/.next/
/out/
next-env.d.ts
/build
/dist

# --- Python (uv / ruff / pytest) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Vercel ---
.vercel

# --- Test / coverage ---
/coverage
.nyc_output

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
*.pem
.idea/

# --- Local tool output ---
.playwright-mcp/
.env*
